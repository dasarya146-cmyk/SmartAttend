# ──────────────────────────────────────────────────────────
# .env.local — Smart Geo Attendance System
# Copy this file to .env.local and fill in your values
# NEVER commit this file to git
# ──────────────────────────────────────────────────────────

# ── MongoDB Atlas (free M0 cluster — no credit card needed) ──────
# 1. Go to https://cloud.mongodb.com
# 2. Create free M0 cluster
# 3. Create DB user + get connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/smartattend?retryWrites=true&w=majority

# ── NextAuth ──────────────────────────────────────────────────────
# NEXTAUTH_SECRET: run this in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_32_CHAR_RANDOM_SECRET

# ── Google OAuth (100% free) ──────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create project → APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 5. For production: https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
